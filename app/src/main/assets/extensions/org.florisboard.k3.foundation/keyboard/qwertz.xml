<keyboard3 xmlns="https://schemas.unicode.org/cldr/45/keyboard3" conformsTo="45" locale="de">
    <info author="Lars Mühlbauer for k3lp" name="German (QWERTZ)" layout="QWERTZ" indicator="DE" />

    <displays>
        <display keyId="base" display="${base_display}" />
        <display keyId="base-to-shift" display="@fl:icon/shift" />
        <display keyId="shift-to-base" display="@fl:icon/shift" />
        <display keyId="symbol-1" display="${symbol_1_display}" />
        <display keyId="symbol-2" display="${symbol_2_display}" />
        <display keyId="numeric" display="${numeric_display}" />
        <display keyId="base-numeric" display="${base_display}" />
        <display keyId="symbols-numeric" display="${symbol_1_display}" />
        <display keyId="space-numeric" display="@fl:icon/space_bar" />
        <display keyId="ime-picker" display="@fl:icon/language_switch" />
    </displays>

    <keys>
        <import base="cldr" path="45/keys-Zyyy-punctuation.xml" />
        <import base="cldr" path="45/keys-Zyyy-currency.xml" />

        <key id="base" layerId="base" width="1.5" />
        <key id="base-to-shift" layerId="shift" width="1.5" />
        <key id="shift-to-base" layerId="base" width="1.5" />
        <key id="numeric" layerId="numeric" />
        <key id="symbol-1" layerId="symbol-1" width="1.5" />
        <key id="symbol-2" layerId="symbol-2" width="1.5" />

        <key id="bksp" output="@k3:action/backspace" stretch="true" />
        <key id="enter" output="@k3:action/enter" width="1.6" />
        <key id="space-no-stretch" output="\u{0020}" />
        <key id="bksp-no-stretch" output="@k3:action/backspace" />
        <key id="ime-picker" output="@fl:action/show_input_method_picker" />
        <key id="space" output="\u{0020}" stretch="true"
             longPressKeyIds="ime-picker" longPressDefaultKeyId="ime-picker" />

        <!-- Numbers -->
        <key id="0" output="0" />
        <key id="1" output="1" />
        <key id="2" output="2" />
        <key id="3" output="3" />
        <key id="4" output="4" />
        <key id="5" output="5" />
        <key id="6" output="6" />
        <key id="7" output="7" />
        <key id="8" output="8" />
        <key id="9" output="9" />

        <!-- Punctuation key popups, mirroring FlorisBoard's de.json "~right" popup mapping -->
        <key id="comma" output=","
             longPressKeyIds="amp percent plus double-quote hyphen colon apos at semi-colon slash open-paren close-paren hash bang question" />

        <!-- Currency slots. Their outputs are substituted at load time based on the subtype's
             currency set. Slot 1 is the primary currency of the set, the rest are common ones. -->
        <key id="currency-1" output="€"
             longPressKeyIds="currency-2 currency-6 currency-3 currency-4 currency-5" />
        <key id="currency-2" output="¥" />
        <key id="currency-3" output="£" />
        <key id="currency-4" output="$" />
        <key id="currency-5" output="¢" />
        <key id="currency-6" output="₹" />

        <!-- Capital keys -->
        <key id="A" output="A"
             longPressKeyIds="at A-umlaut AE-lig A-tilde A-ring A-charon A-caret A-grave A-acute" longPressDefaultKeyId="at" />
        <key id="A-umlaut" output="Ä" />
        <key id="A-grave" output="À" />
        <key id="A-acute" output="Á" />
        <key id="A-caret" output="Â" />
        <key id="A-tilde" output="Ã" />
        <key id="A-ring" output="Å" />
        <key id="A-charon" output="Ā" />
        <key id="AE-lig" output="Æ" />
        <key id="B" output="B" longPressKeyIds="semi-colon" longPressDefaultKeyId="semi-colon" />
        <key id="C" output="C" longPressKeyIds="apos" longPressDefaultKeyId="apos" />
        <key id="D" output="D" longPressKeyIds="currency-1" longPressDefaultKeyId="currency-1" />
        <key id="E" output="E" longPressKeyIds="pipe E-acute E-charon E-caret E-grave E-umlaut" longPressDefaultKeyId="pipe" />
        <key id="E-umlaut" output="Ë" />
        <key id="E-grave" output="È" />
        <key id="E-acute" output="É" />
        <key id="E-caret" output="Ê" />
        <key id="E-tilde" output="Ẽ" />
        <key id="E-ring" output="Ė" />
        <key id="E-charon" output="Ē" />
        <key id="F" output="F" longPressKeyIds="underscore" longPressDefaultKeyId="underscore" />
        <key id="G" output="G" longPressKeyIds="amp" longPressDefaultKeyId="amp" />
        <key id="H" output="H" longPressKeyIds="hyphen" longPressDefaultKeyId="hyphen" />
        <key id="I" output="I" longPressKeyIds="close-angle I-acute I-grave I-umlaut I-caret I-charon" longPressDefaultKeyId="close-angle" />
        <key id="I-umlaut" output="Ï" />
        <key id="I-grave" output="Ì" />
        <key id="I-acute" output="Í" />
        <key id="I-caret" output="Î" />
        <key id="I-tilde" output="Ĩ" />
        <key id="I-charon" output="Ī" />
        <key id="J" output="J" longPressKeyIds="plus" longPressDefaultKeyId="plus" />
        <key id="K" output="K" longPressKeyIds="open-paren" longPressDefaultKeyId="open-paren" />
        <key id="L" output="L" longPressKeyIds="close-paren" longPressDefaultKeyId="close-paren" />
        <key id="M" output="M" longPressKeyIds="question" longPressDefaultKeyId="question" />
        <key id="N" output="N" longPressKeyIds="bang N-tilde N-acute" longPressDefaultKeyId="bang" />
        <key id="N-tilde" output="Ñ" />
        <key id="N-acute" output="Ń" />
        <key id="O" output="O"
             longPressKeyIds="open-curly O-umlaut O-charon O-stroke O-tilde OE-lig O-acute O-grave O-caret" longPressDefaultKeyId="open-curly" />
        <key id="O-umlaut" output="Ö" />
        <key id="O-grave" output="Ò" />
        <key id="O-acute" output="Ó" />
        <key id="O-caret" output="Ô" />
        <key id="O-tilde" output="Õ" />
        <key id="O-charon" output="Ō" />
        <key id="O-stroke" output="Ø" />
        <key id="OE-lig" output="Œ" />
        <key id="P" output="P" longPressKeyIds="close-curly" longPressDefaultKeyId="close-curly" />
        <key id="Q" output="Q" longPressKeyIds="percent" longPressDefaultKeyId="percent" />
        <key id="R" output="R" longPressKeyIds="equal" longPressDefaultKeyId="equal" />
        <key id="S" output="S" longPressKeyIds="hash S-sharp S-caron S-acute" longPressDefaultKeyId="hash" />
        <key id="S-caron" output="Š" />
        <key id="S-sharp" output="ẞ" />
        <key id="S-acute" output="Ś" />
        <key id="T" output="T" longPressKeyIds="open-square" longPressDefaultKeyId="open-square" />
        <key id="U" output="U" longPressKeyIds="open-angle U-umlaut U-charon U-grave U-caret U-acute" longPressDefaultKeyId="open-angle" />
        <key id="U-umlaut" output="Ü" />
        <key id="U-grave" output="Ù" />
        <key id="U-acute" output="Ú" />
        <key id="U-caret" output="Û" />
        <key id="U-tilde" output="Ũ" />
        <key id="U-ring" output="Ů" />
        <key id="U-charon" output="Ū" />
        <key id="V" output="V" longPressKeyIds="colon" longPressDefaultKeyId="colon" />
        <key id="W" output="W" longPressKeyIds="backslash" longPressDefaultKeyId="backslash" />
        <key id="X" output="X" longPressKeyIds="double-quote" longPressDefaultKeyId="double-quote" />
        <key id="Y" output="Y" longPressKeyIds="asterisk" longPressDefaultKeyId="asterisk" />
        <key id="Y-umlaut" output="Ÿ" />
        <key id="Y-grave" output="Ỳ" />
        <key id="Y-acute" output="Ý" />
        <key id="Y-caret" output="Ŷ" />
        <key id="Y-tilde" output="Ỹ" />
        <key id="Y-charon" output="Ȳ" />
        <key id="Z" output="Z" longPressKeyIds="close-square" longPressDefaultKeyId="close-square" />

        <!-- Lowercase keys -->
        <key id="a" output="a"
             longPressKeyIds="at a-umlaut ae-lig a-tilde a-ring a-charon a-caret a-grave a-acute"
             flickId="a-flicks" longPressDefaultKeyId="at" />
        <key id="a-umlaut" output="ä" />
        <key id="a-grave" output="à" />
        <key id="a-acute" output="á" />
        <key id="a-caret" output="â" />
        <key id="a-tilde" output="ã" />
        <key id="a-ring" output="å" />
        <key id="a-charon" output="ā" />
        <key id="ae-lig" output="æ" />
        <key id="b" output="b" longPressKeyIds="semi-colon" longPressDefaultKeyId="semi-colon" />
        <key id="c" output="c" longPressKeyIds="apos" longPressDefaultKeyId="apos" />
        <key id="d" output="d" longPressKeyIds="currency-1" longPressDefaultKeyId="currency-1" />
        <key id="e" output="e" longPressKeyIds="pipe e-acute e-charon e-caret e-grave e-umlaut" longPressDefaultKeyId="pipe" />
        <key id="e-umlaut" output="ë" />
        <key id="e-grave" output="è" />
        <key id="e-acute" output="é" />
        <key id="e-caret" output="ê" />
        <key id="e-tilde" output="ẽ" />
        <key id="e-ring" output="ė" />
        <key id="e-charon" output="ē" />
        <key id="f" output="f" longPressKeyIds="underscore" longPressDefaultKeyId="underscore" />
        <key id="g" output="g" longPressKeyIds="amp" longPressDefaultKeyId="amp" />
        <key id="h" output="h" longPressKeyIds="hyphen" longPressDefaultKeyId="hyphen" />
        <key id="i" output="i" longPressKeyIds="close-angle i-acute i-grave i-umlaut i-caret i-charon" longPressDefaultKeyId="close-angle" />
        <key id="i-umlaut" output="ï" />
        <key id="i-grave" output="ì" />
        <key id="i-acute" output="í" />
        <key id="i-caret" output="î" />
        <key id="i-tilde" output="ĩ" />
        <key id="i-charon" output="ī" />
        <key id="j" output="j" longPressKeyIds="plus" longPressDefaultKeyId="plus" />
        <key id="k" output="k" longPressKeyIds="open-paren" longPressDefaultKeyId="open-paren" />
        <key id="l" output="l" longPressKeyIds="close-paren" longPressDefaultKeyId="close-paren" />
        <key id="m" output="m" longPressKeyIds="question" longPressDefaultKeyId="question" />
        <key id="n" output="n" longPressKeyIds="bang n-tilde n-acute" longPressDefaultKeyId="bang" />
        <key id="n-tilde" output="ñ" />
        <key id="n-acute" output="ń" />
        <key id="o" output="o"
             longPressKeyIds="open-curly o-umlaut o-charon o-stroke o-tilde oe-lig o-acute o-grave o-caret" longPressDefaultKeyId="open-curly" />
        <key id="o-umlaut" output="ö" />
        <key id="o-grave" output="ò" />
        <key id="o-acute" output="ó" />
        <key id="o-caret" output="ô" />
        <key id="o-tilde" output="õ" />
        <key id="o-charon" output="ō" />
        <key id="o-stroke" output="ø" />
        <key id="oe-lig" output="œ" />
        <key id="p" output="p" longPressKeyIds="close-curly" longPressDefaultKeyId="close-curly" />
        <key id="q" output="q" longPressKeyIds="percent" longPressDefaultKeyId="percent" />
        <key id="r" output="r" longPressKeyIds="equal" longPressDefaultKeyId="equal" />
        <key id="s" output="s" longPressKeyIds="hash s-sharp s-caron s-acute" longPressDefaultKeyId="hash" />
        <key id="s-caron" output="š" />
        <key id="s-sharp" output="ß" />
        <key id="s-acute" output="ś" />
        <key id="t" output="t" longPressKeyIds="open-square" longPressDefaultKeyId="open-square" />
        <key id="u" output="u" longPressKeyIds="open-angle u-umlaut u-charon u-grave u-caret u-acute" longPressDefaultKeyId="open-angle" />
        <key id="u-umlaut" output="ü" />
        <key id="u-grave" output="ù" />
        <key id="u-acute" output="ú" />
        <key id="u-caret" output="û" />
        <key id="u-tilde" output="ũ" />
        <key id="u-ring" output="ů" />
        <key id="u-charon" output="ū" />
        <key id="v" output="v" longPressKeyIds="colon" longPressDefaultKeyId="colon" />
        <key id="w" output="w" longPressKeyIds="backslash" longPressDefaultKeyId="backslash" />
        <key id="x" output="x" longPressKeyIds="double-quote" longPressDefaultKeyId="double-quote" />
        <key id="y" output="y" longPressKeyIds="asterisk" longPressDefaultKeyId="asterisk" />
        <key id="y-umlaut" output="ÿ" />
        <key id="y-grave" output="ỳ" />
        <key id="y-acute" output="ý" />
        <key id="y-caret" output="ŷ" />
        <key id="y-tilde" output="ỹ" />
        <key id="y-charon" output="ȳ" />
        <key id="z" output="z" longPressKeyIds="close-square" longPressDefaultKeyId="close-square" />
        <!-- extra chars -->
        <key id="numero-sign" output="\u{2116}" />
        <key id="permille" output="\u{2030}" />
        <key id="care-of" output="\u{2105}" />
        <key id="acute" output="´" />

        <!-- Symbols matching FlorisBoard's Western (Additional symbols) and symbols2 layers -->
        <key id="percent" output="%" longPressKeyIds="permille care-of" />
        <key id="equal" output="=" longPressKeyIds="not-equal infinity approximately" />
        <key id="not-equal" output="\u{2260}" />
        <key id="infinity" output="\u{221E}" />
        <key id="approximately" output="\u{2248}" />
        <key id="caret" output="^" longPressKeyIds="arrow-up arrow-left arrow-down arrow-right" />
        <key id="arrow-up" output="\u{2191}" />
        <key id="arrow-left" output="\u{2190}" />
        <key id="arrow-down" output="\u{2193}" />
        <key id="arrow-right" output="\u{2192}" />
        <key id="degree" output="°" longPressKeyIds="prime double-prime" />
        <key id="prime" output="\u{2032}" />
        <key id="double-prime" output="\u{2033}" />
        <key id="open-curly" output="{" longPressKeyIds="open-paren" />
        <key id="close-curly" output="}" longPressKeyIds="close-paren" />
        <key id="bullet" output="\u{2022}"
             longPressKeyIds="music-note club-suit spade-suit heart-suit diamond-suit" />
        <key id="music-note" output="\u{266A}" />
        <key id="club-suit" output="\u{2663}" />
        <key id="spade-suit" output="\u{2660}" />
        <key id="heart-suit" output="\u{2665}" />
        <key id="diamond-suit" output="\u{2666}" />
        <key id="root" output="\u{221A}" />
        <key id="pi" output="π"
             longPressKeyIds="capital-pi omega alpha beta capital-omega mu" />
        <key id="capital-pi" output="\u{03A0}" />
        <key id="omega" output="\u{03C9}" />
        <key id="alpha" output="\u{03B1}" />
        <key id="beta" output="\u{03B2}" />
        <key id="capital-omega" output="\u{03A9}" />
        <key id="mu" output="\u{03BC}" />
        <key id="divide" output="÷" />
        <key id="multiply" output="×" />
        <key id="paragraph" output="¶" longPressKeyIds="section-sign" />
        <key id="section-sign" output="\u{00A7}" />
        <key id="delta" output="\u{2206}" />
        <key id="copyright" output="\u{00A9}" />
        <key id="registered" output="\u{00AE}" />
        <key id="trademark" output="\u{2122}" />
        <key id="checkmark" output="\u{2713}" />

        <!-- numeric layout keys -->
        <key id="plus-numeric" output="+" width="1.8" longPressKeyIds="hyphen asterisk slash" />
        <key id="open-paren-numeric" output="(" width="1.8" longPressKeyIds="open-square open-curly" />
        <key id="close-paren-numeric" output=")" width="1.8"
             longPressKeyIds="close-square close-curly" />
        <key id="percent-numeric" output="%" width="1.8" />
        <key id="space-numeric" output="\u{0020}" width="1.8" />
        <key id="bksp-numeric" output="@k3:action/backspace" width="1.8" />
        <key id="base-numeric" layerId="base" width="1.8" />
        <key id="comma-numeric" output="," width="1.1" />
        <key id="symbols-numeric" layerId="symbol-1" width="1.9" />
        <key id="equal-numeric" output="=" width="1.9" />
        <key id="period-numeric" output="." width="1.1" />
        <key id="enter-numeric" output="@k3:action/enter" width="1.8" />
        <key id="0-numeric" width="3" output="0" />
        <key id="1-numeric" width="3" output="1" />
        <key id="2-numeric" width="3" output="2" />
        <key id="3-numeric" width="3" output="3" />
        <key id="4-numeric" width="3" output="4" />
        <key id="5-numeric" width="3" output="5" />
        <key id="6-numeric" width="3" output="6" />
        <key id="7-numeric" width="3" output="7" />
        <key id="8-numeric" width="3" output="8" />
        <key id="9-numeric" width="3" output="9" />
    </keys>

    <flicks>
        <flick id="a-flicks">
            <flickSegment directions="ne s" keyId="b" />
        </flick>
    </flicks>

    <layers formId="iso">
        <layer modifiers="none">
            <row
                keys="caret 1 2 3 4 5 6 7 8 9 0 s-sharp acute" />
            <row keys="q w e r t z u i o p u-umlaut plus" />
            <row keys="a s d f g h j k l o-umlaut a-umlaut hash" />
            <row keys="open-angle y x c v b n m comma period hyphen" />
            <row keys="space" />
        </layer>
        <layer modifiers="shift">
            <row
                keys="degree bang double-quote section dollar percent amp slash open-paren close-paren equal question grave" />
            <row keys="Q W E R T Z U I O P U-umlaut asterisk" />
            <row keys="A S D F G H J K L O-umlaut A-umlaut apos" />
            <row keys="close-angle Y X C V B N M semi-colon colon underscore" />
            <row keys="space" />
        </layer>
        <layer modifiers="altR">
            <row
                keys="not gap gap gap gap gap not open-curly open-square close-square close-curly backslash gap" />
            <row keys="at gap euro gap gap gap gap gap gap gap gap tilde" />
            <row keys="gap gap gap gap gap gap gap gap gap gap gap gap" />
            <row keys="pipe gap gap gap gap gap gap micro gap gap gap" />
            <row keys="space" />
        </layer>
    </layers>

    <layers formId="touch" minDeviceWidth="1">
        <import path="flex://org.florisboard.k3.foundation/layers-touch.xml" />

        <layer id="numrow">
            <row keys="numrow-1 numrow-2 numrow-3 numrow-4 numrow-5 numrow-6 numrow-7 numrow-8 numrow-9 numrow-0" />
        </layer>

        <layer id="base">
            <row keys="q w e r t z u i o p" />
            <row keys="a s d f g h j k l" />
            <row keys="base-to-shift y x c v b n m bksp" />
            <row keys="symbol-1 comma fn-key space period enter" />
        </layer>

        <layer id="shift">
            <row keys="Q W E R T Z U I O P" />
            <row keys="A S D F G H J K L" />
            <row keys="shift-to-base Y X C V B N M bksp" />
            <row keys="symbol-1 comma fn-key space period enter" />
        </layer>

        <layer id="symbol-1">
            <row keys="1 2 3 4 5 6 7 8 9 0" />
            <row keys="percent backslash pipe equal open-square close-square open-angle close-angle open-curly close-curly" />
            <row keys="at hash currency-1 underscore amp hyphen plus open-paren close-paren slash" />
            <row keys="symbol-2 asterisk double-quote apos colon semi-colon bang question bksp" />
            <row keys="base comma numeric space period enter" />
        </layer>

        <layer id="symbol-2">
            <row keys="tilde grave pipe bullet root pi divide multiply paragraph delta" />
            <row keys="currency-5 currency-4 currency-3 currency-2 caret degree equal open-curly close-curly backslash" />
            <row keys="symbol-1 underscore copyright registered trademark checkmark open-square close-square bksp" />
            <row keys="base open-angle numeric space close-angle enter" />
        </layer>

        <layer id="numeric">
            <row keys="plus-numeric 1-numeric 2-numeric 3-numeric percent-numeric" />
            <row keys="open-paren-numeric 4-numeric 5-numeric 6-numeric space-numeric" />
            <row keys="close-paren-numeric 7-numeric 8-numeric 9-numeric bksp-numeric" />
            <row
                keys="base-numeric comma-numeric symbols-numeric 0-numeric equal-numeric period-numeric enter-numeric" />
        </layer>
    </layers>

    <variables>
        <string id="base_display" value="ABC" />
        <string id="shift_display" value="\u{21EA}" />
        <string id="numeric_display" value="1 2&#10;3 4" />
        <string id="symbol_1_display" value="?123" />
        <string id="symbol_2_display" value="\u{003D 005C 003C}" />
    </variables>
</keyboard3>
